# Copy to .env for local development. In production these are set on the
# DigitalOcean app (see .do/app.yaml); never commit real values.

DATABASE_URL=postgres://hq:hq@localhost:5432/products_hq
BASE_URL=http://localhost:8080
ADMIN_PASSWORD=change-me
ALERT_EMAIL=info@felixclarke.com

# Stripe: the Email First Ltd account. Add a webhook endpoint pointing at
# <BASE_URL>/webhooks/stripe with these events:
#   checkout.session.completed, customer.subscription.updated,
#   customer.subscription.deleted, invoice.payment_failed, invoice.paid,
#   charge.dispute.created, charge.dispute.updated, charge.dispute.closed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Outgoing email. Use "log" locally to print emails instead of sending.
SMTP_URL=log

# Replies: set REPLY_TO on outgoing mail and let the app read that mailbox.
# REPLY_TO=replies@business-leads.co.uk
# IMAP_URL=imaps://replies%40business-leads.co.uk:password@imap.example.com:993

# Claude drafts replies, reports, scripts and copy.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5
# CLAUDE_EFFORT=medium

# Per-product sender addresses (defaults are in src/products/*.ts)
# FROM_FIRSTPAGELOCAL=hello@firstpagelocal.com
# FROM_LINKN=felix@linkn.co.uk
# FROM_SPEEDTOLEAD=
# FROM_EMAILFIRST=
# FROM_GOODQUESTIONS=felix@goodquestions.co.uk

# Extra origins allowed to post enquiries (e.g. custom domains once connected)
# ALLOWED_ORIGINS=https://firstpagelocal.com,https://linkn.co.uk
# Extra URLs to health-check: name|url,name|url
# EXTRA_HEALTH_URLS=firstpagelocal|https://firstpagelocal.com

# Tool integrations (not wired to their APIs yet; work becomes manual tasks)
# AWAZ_API_KEY=
# LOCALFALCON_API_KEY=
# MAILWIZZ_API_URL=
# MAILWIZZ_API_KEY=
# FEEDBOSS_API_KEY=
# SBL_API_KEY=
# SBL_COMPANY_ID=
# SCOREAPP_API_KEY=
